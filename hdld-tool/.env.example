# ── hdld-tool / sinh HĐLĐ ─────────────────────────────────────────────────────

# Cổng HTTP (mini: 3502 trống — 3100 hr, 3200 dxc, 3300 support, 3400 track bận)
PORT=3502

# ── Lark side (đọc/ghi Base qua lark-cli đã config profile sẵn trên Mac mini) ──
# Profile lark-cli có quyền ĐỌC + GHI bitable trên base HR (DLewbVqU7aZM65sAW6mlcOpngse).
# Mặc định dùng app reader của tenant1 iSuccess; đổi nếu profile khác có quyền.
LARK_PROFILE=cli_a80df38cc639d02f
# Đường dẫn binary lark-cli (mini: /opt/homebrew/bin/lark-cli)
LARK_CLI=/opt/homebrew/bin/lark-cli

# ── Google side (service account JSON: copy template + replace placeholder) ───
# Đường dẫn file service account key (.json). SA phải được SHARE quyền Editor:
#   - các Google Doc template (bảng 26) → để copy
#   - thư mục đích GOOGLE_DEST_FOLDER_ID  → để chứa doc sinh ra
GOOGLE_SA_KEY=/Users/duong/hdld-tool/sa-key.json

# Thư mục đích chứa tài liệu sinh ra. NÊN là 1 thư mục trong SHARED DRIVE
# (service account thường KHÔNG có quota lưu trong My Drive cá nhân → copy sẽ lỗi).
# Để trống = copy vào Drive của SA (chỉ chạy được nếu SA là Workspace có quota).
GOOGLE_DEST_FOLDER_ID=

# ── Bảo vệ endpoint public ────────────────────────────────────────────────────
# Token Lark Base Automation phải gửi kèm (body.token / ?token= / Authorization: Bearer).
# Để trống = không yêu cầu (chỉ an toàn khi server KHÔNG public qua tunnel).
HDLD_TOKEN=

# ── Override doc-id template (xử lý mismatch TEM001) ──────────────────────────
# JSON map: { "<id sai>": "<id đúng>" }. Khi resolve ra id bên trái, server thay bằng id bên phải.
# Mặc định để trống → server tự lấy doc-id từ field "Link template" (doc người sửa thật).
# TEMPLATE_DOC_OVERRIDE={"1F1xGmACD8ru1ugs4kZzXRnRNG2bTOpibRMCtx5W2qb4":"1c9NxZeQEnrT4IUFBauS_vVMF7XFXqNDejL1g7c7qtLs"}
TEMPLATE_DOC_OVERRIDE=
